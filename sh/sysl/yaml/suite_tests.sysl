module sh.sysl.yaml
@tests

import sysl.buf.{Buf, buf}
import sysl.text.{StrBuilder, str_builder}

// The YAML test suite, run against this binding.
//
// **This file is generated from `yaml/yaml-test-suite`'s `data` branch** — 402 leaf cases, each an
// input document and either the event stream it must produce or a marker saying it must be refused.
// The corpus is committed rather than fetched, because 18 KB of YAML and 34 KB of expected events is
// small enough to live here and a test that needs the network is a test that does not run.
//
// **What it checks is not "did libyaml agree with the suite".** That is measured, and it is a fact
// about libyaml rather than about this package: libyaml is a YAML **1.1** parser and the suite is
// written for **1.2**, so 72 of the 402 cases come out differently and always will. What this file
// checks is that *this binding reproduces libyaml exactly* — the same 330 conforming and the same 72
// diverging, each named with what it does instead.
//
// **The divergence list is asserted in both directions**, which is what makes it worth writing down:
// a case listed as diverging that starts to conform fails the test and names the line to delete. So
// an upgrade of libyaml that fixes one of these is reported rather than absorbed.
//
// **The event text is the suite's own format**, which libyaml's `tests/run-parser-test-suite.c`
// writes and this file re-implements over `Parser`: `+STR`, `+DOC ---`, `=VAL &a <tag> :text`,
// `=ALI *a`, `-MAP` and the rest, with `{}` and `[]` marking a flow collection. Re-implementing it
// is the point — it is what exercises every field of every event, which no smaller test does.

/** One case: what it is called upstream, the document, what the suite says it must produce, and
 * what this binding is known to do instead where the two disagree.
 */
private struct Case
    id: string
    input: string
    expected: string
    invalid: bool
    divergence: string

/** The event stream in the suite's own notation, or the error the document produced. */
private events_of(text: string) -> Result[string, Error]
    val p = parser(text)?

    var b = str_builder()

    loop
        val l = p.next()?

        l.event match
            StreamStart -> b.push("+STR\n")

            StreamEnd ->
                b.push("-STR\n")
                break

            DocumentStart(explicit) -> b.push(if explicit then "+DOC ---\n" else "+DOC\n")
            DocumentEnd(explicit) -> b.push(if explicit then "-DOC ...\n" else "-DOC\n")

            Alias(name) ->
                b.push("=ALI *")
                b.push(name)
                b.push("\n")

            Scalar(value, anchor, tag, style, _, _) ->
                b.push("=VAL")
                marks(&b, anchor, tag)
                b.push(" ")
                b.push(style_of(style))
                escaped_into(&b, value)
                b.push("\n")

            SequenceStart(anchor, tag, style, _) ->
                b.push("+SEQ")

                style match
                    Flow -> b.push(" []")
                    Block -> ()

                marks(&b, anchor, tag)
                b.push("\n")

            SequenceEnd -> b.push("-SEQ\n")

            MappingStart(anchor, tag, style, _) ->
                b.push("+MAP")

                style match
                    Flow -> b.push(" {}")
                    Block -> ()

                marks(&b, anchor, tag)
                b.push("\n")

            MappingEnd -> b.push("-MAP\n")

    Ok(b.finish())
end events_of

/** An anchor and a tag, in the order the notation writes them. */
private marks(b: *StrBuilder, anchor: Option[string], tag: Option[string])
    anchor match
        Some(a) ->
            b.push(" &")
            b.push(a)
        None -> ()

    tag match
        Some(t) ->
            b.push(" <")
            b.push(t)
            b.push(">")
        None -> ()

/** The one character standing for how a scalar was written. */
private style_of(s: ScalarStyle) -> string = s match
    Plain -> ":"
    SingleQuoted -> "'"
    DoubleQuoted -> "\""
    Literal -> "|"
    Folded -> ">"

/** The notation's escapes, which are six and no more: everything else is written as itself, a
 * multi-byte character included.
 */
private escaped_into(b: *StrBuilder, s: string)
    val bs = s.bytes
    var start: usize = 0

    for i in 0..<bs.len
        val rep = suite_escape(bs[i])

        if rep != ""
            b.push(s[start..<i])
            b.push(rep)
            start = i + 1

    b.push(s[start..])
end escaped_into

private suite_escape(b: u8) -> string =
    if b == u8('\\') then
        "\\\\"
    elif b == 0 then
        "\\0"
    elif b == u8('\b') then
        "\\b"
    elif b == u8('\n') then
        "\\n"
    elif b == u8('\r') then
        "\\r"
    elif b == u8('\t') then
        "\\t"
    else
        ""

/** How many of the 402 the suite and this binding agree about, exactly. */
private const CONFORMING: usize = 330

/** How many libyaml reads differently. Every one is named in the table below, with what it does
 * instead of what the suite says.
 */
private const DIVERGING: usize = 72

/** The corpus. Generated; do not edit by hand. */
private corpus() -> [402]Case = [
    Case("229Q", "-\n  name: Mark McGwire\n  hr:   65\n  avg:  0.278\n-\n  name: Sammy Sosa\n  hr:   63\n  avg:  0.288\n", "+STR\n+DOC\n+SEQ\n+MAP\n=VAL :name\n=VAL :Mark McGwire\n=VAL :hr\n=VAL :65\n=VAL :avg\n=VAL :0.278\n-MAP\n+MAP\n=VAL :name\n=VAL :Sammy Sosa\n=VAL :hr\n=VAL :63\n=VAL :avg\n=VAL :0.288\n-MAP\n-SEQ\n-DOC\n-STR\n", false, ""),
    Case("236B", "foo:\n  bar\ninvalid\n", "", true, ""),
    Case("26DV", "\"top1\" : \n  \"key1\" : &alias1 scalar1\n'top2' : \n  'key2' : &alias2 scalar2\ntop3: &node3 \n  *alias1 : scalar3\ntop4: \n  *alias2 : scalar4\ntop5   :    \n  scalar5\ntop6: \n  &anchor6 'key6' : scalar6\n", "+STR\n+DOC\n+MAP\n=VAL \"top1\n+MAP\n=VAL \"key1\n=VAL &alias1 :scalar1\n-MAP\n=VAL 'top2\n+MAP\n=VAL 'key2\n=VAL &alias2 :scalar2\n-MAP\n=VAL :top3\n+MAP &node3\n=ALI *alias1\n=VAL :scalar3\n-MAP\n=VAL :top4\n+MAP\n=ALI *alias2\n=VAL :scalar4\n-MAP\n=VAL :top5\n=VAL :scalar5\n=VAL :top6\n+MAP\n=VAL &anchor6 'key6\n=VAL :scalar6\n-MAP\n-MAP\n-DOC\n-STR\n", false, ""),
    Case("27NA", "%YAML 1.2\n--- text\n", "+STR\n+DOC ---\n=VAL :text\n-DOC\n-STR\n", false, ""),
    Case("2AUY", " - !!str a\n - b\n - !!int 42\n - d\n", "+STR\n+DOC\n+SEQ\n=VAL <tag:yaml.org,2002:str> :a\n=VAL :b\n=VAL <tag:yaml.org,2002:int> :42\n=VAL :d\n-SEQ\n-DOC\n-STR\n", false, ""),
    Case("2CMS", "this\n is\n  invalid: x\n", "", true, ""),
