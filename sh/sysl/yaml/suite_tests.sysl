    Case("F8F9", " # Strip\n  # Comments:\nstrip: |-\n  # text\n  \n # Clip\n  # comments:\n\nclip: |\n  # text\n \n # Keep\n  # comments:\n\nkeep: |+\n  # text\n\n # Trail\n  # comments.\n", "+STR\n+DOC\n+MAP\n=VAL :strip\n=VAL |# text\n=VAL :clip\n=VAL |# text\\n\n=VAL :keep\n=VAL |# text\\n\\n\n-MAP\n-DOC\n-STR\n", false, ""),
    Case("FBC9", "safe: a!\"#\u{24}%&'()*+,-./09:;<=>?@AZ[\\]^_`az{|}~\n     !\"#\u{24}%&'()*+,-./09:;<=>?@AZ[\\]^_`az{|}~\nsafe question mark: ?foo\nsafe colon: :foo\nsafe dash: -foo\n", "+STR\n+DOC\n+MAP\n=VAL :safe\n=VAL :a!\"#\u{24}%&'()*+,-./09:;<=>?@AZ[\\\\]^_`az{|}~ !\"#\u{24}%&'()*+,-./09:;<=>?@AZ[\\\\]^_`az{|}~\n=VAL :safe question mark\n=VAL :?foo\n=VAL :safe colon\n=VAL ::foo\n=VAL :safe dash\n=VAL :-foo\n-MAP\n-DOC\n-STR\n", false, ""),
