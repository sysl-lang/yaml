/** Every case in the corpus, run.
 *
 * The two counts at the end are what make this a regression test rather than a survey: a case that
 * stops conforming reddens, and so does a case that *starts* conforming while still listed as
 * diverging — the second is the one a libyaml upgrade would produce, and it names the line to delete.
 */
@test
yaml_test_suite() =
    var conforming: usize = 0
    var diverging: usize = 0
    var problems: Buf[string] = buf()

    for c in corpus()
        val got = events_of(c.input)

        val agreed = got match
            Ok(text) -> !c.invalid && text == c.expected
            Err(_) -> c.invalid

        if c.divergence == ""
            if agreed then
                conforming += 1
            else
                problems.push(s"${c.id} conformed and no longer does")
        else
            if agreed then
                problems.push(s"${c.id} is listed as diverging (${c.divergence}) and now conforms — delete its line")
            else
                diverging += 1

    assert_eq(problems.len(), 0usize, first_problem(problems))
    assert_eq(conforming, CONFORMING, "the number of cases this binding reads exactly as the suite says")
    assert_eq(diverging, DIVERGING, "the number of cases libyaml reads differently, each named above")

/** The first thing that went wrong, which is the one a person reads. */
private first_problem(problems: Buf[string]) -> string =
    if problems.is_empty() then
        "every case agreed"
    else
        s"${problems.at(0)} (and ${problems.len() - 1} more)"
