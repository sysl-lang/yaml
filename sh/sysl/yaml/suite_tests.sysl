    Case("M6YH", "- |\n x\n-\n foo: bar\n-\n - 42\n", "+STR\n+DOC\n+SEQ\n=VAL |x\\n\n+MAP\n=VAL :foo\n=VAL :bar\n-MAP\n+SEQ\n=VAL :42\n-SEQ\n-SEQ\n-DOC\n-STR\n", false, ""),
