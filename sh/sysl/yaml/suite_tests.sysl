    Case("JR7V", "- a?string\n- another ? string\n- key: value?\n- [a?string]\n- [another ? string]\n- {key: value? }\n- {key: value?}\n- {key?: value }\n", "+STR\n+DOC\n+SEQ\n=VAL :a?string\n=VAL :another ? string\n+MAP\n=VAL :key\n=VAL :value?\n-MAP\n+SEQ []\n=VAL :a?string\n-SEQ\n+SEQ []\n=VAL :another ? string\n-SEQ\n+MAP {}\n=VAL :key\n=VAL :value?\n-MAP\n+MAP {}\n=VAL :key\n=VAL :value?\n-MAP\n+MAP {}\n=VAL :key?\n=VAL :value\n-MAP\n-SEQ\n-DOC\n-STR\n", false, ""),
    Case("JS2J", "First occurrence: &anchor Value\nSecond occurrence: *anchor\n", "+STR\n+DOC\n+MAP\n=VAL :First occurrence\n=VAL &anchor :Value\n=VAL :Second occurrence\n=ALI *anchor\n-MAP\n-DOC\n-STR\n", false, ""),
    Case("JTV5", "? a\n  true\n: null\n  d\n? e\n  42\n", "+STR\n+DOC\n+MAP\n=VAL :a true\n=VAL :null d\n=VAL :e 42\n=VAL :\n-MAP\n-DOC\n-STR\n", false, ""),
